<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 400 400" width="400" height="400">
  <defs>
    <linearGradient id="bg" x1="0%" y1="0%" x2="100%" y2="100%">
      <stop offset="0%" style="stop-color:#FAFAFA"/>
      <stop offset="100%" style="stop-color:#F5EDE6"/>
    </linearGradient>
    <linearGradient id="cup" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#FFFFFF"/>
      <stop offset="100%" style="stop-color:#F0E6DC"/>
    </linearGradient>
    <linearGradient id="coffee" x1="0%" y1="0%" x2="0%" y2="100%">
      <stop offset="0%" style="stop-color:#8C5A43"/>
      <stop offset="100%" style="stop-color:#4B2E2A"/>
    </linearGradient>
    <radialGradient id="foam" cx="50%" cy="40%" r="50%">
      <stop offset="0%" style="stop-color:#D4A373"/>
      <stop offset="100%" style="stop-color:#8C5A43"/>
    </radialGradient>
    <filter id="shadow" x="-20%" y="-20%" width="140%" height="140%">
      <feDropShadow dx="0" dy="4" stdDeviation="8" flood-color="#4B2E2A" flood-opacity="0.15"/>
    </filter>
  </defs>
  <rect width="400" height="400" fill="url(#bg)"/>
  <circle cx="200" cy="200" r="160" fill="#F5EDE6" opacity="0.5"/>
  <g filter="url(#shadow)" transform="translate(200,210)">
    <ellipse cx="0" cy="60" rx="90" ry="18" fill="#4B2E2A" opacity="0.1"/>
    <path d="M-70,-40 Q-70,-80 -50,-80 L50,-80 Q70,-80 70,-40 L65,40 Q65,60 45,60 L-45,60 Q-65,60 -65,40 Z" fill="url(#cup)" stroke="#D4A373" stroke-width="2"/>
    <path d="M70,-30 Q100,-30 100,0 Q100,30 70,30" fill="none" stroke="#D4A373" stroke-width="6" stroke-linecap="round"/>
    <ellipse cx="0" cy="-40" rx="65" ry="14" fill="url(#foam)"/>
    <ellipse cx="0" cy="-40" rx="55" ry="10" fill="#D4A373" opacity="0.6"/>
    <path d="M-20,-42 Q-10,-50 0,-42 Q10,-34 20,-42" fill="none" stroke="#FAFAFA" stroke-width="2" stroke-linecap="round" opacity="0.8"/>
    <path d="M-10,-38 Q0,-44 10,-38" fill="none" stroke="#FAFAFA" stroke-width="1.5" stroke-linecap="round" opacity="0.6"/>
    <path d="M-30,-40 Q-25,-45 -20,-40" fill="none" stroke="#FAFAFA" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
    <path d="M15,-40 Q20,-45 25,-40" fill="none" stroke="#FAFAFA" stroke-width="1.5" stroke-linecap="round" opacity="0.5"/>
    <path d="M-5,-55 Q-3,-65 0,-70 Q3,-65 5,-55" fill="none" stroke="#8C5A43" stroke-width="1.5" opacity="0.4"/>
    <path d="M-15,-55 Q-13,-63 -10,-68" fill="none" stroke="#8C5A43" stroke-width="1" opacity="0.3"/>
    <path d="M10,-55 Q12,-63 15,-68" fill="none" stroke="#8C5A43" stroke-width="1" opacity="0.3"/>
  </g>
  <g transform="translate(200,340)">
    <text x="0" y="0" text-anchor="middle" font-family="'Playfair Display', serif" font-size="16" fill="#4B2E2A" font-weight="bold">Brew Haven</text>
    <text x="0" y="18" text-anchor="middle" font-family="'Open Sans', sans-serif" font-size="10" fill="#8C5A43">Artisan Coffee &amp; Pastries</text>
  </g>
  <g opacity="0.15">
    <circle cx="60" cy="80" r="20" fill="#D4A373"/>
    <circle cx="340" cy="100" r="15" fill="#8C5A43"/>
    <circle cx="50" cy="320" r="12" fill="#4B2E2A"/>
    <circle cx="350" cy="300" r="18" fill="#D4A373"/>
  </g>
</svg>